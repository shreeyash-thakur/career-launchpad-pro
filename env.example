# Firebase project config — from Firebase Console → Project settings → General
# → "Your apps" → Web app → SDK setup and configuration.
#
# Copy this file to `.env` (or `.env.local`) and fill in your values.
# Vite only exposes variables prefixed with VITE_ to client code, so keep the
# prefix exactly as-is.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# OpenRouter API key — get yours at https://openrouter.ai/keys
#
# IMPORTANT: this intentionally has NO VITE_ prefix. Vite only bundles
# VITE_-prefixed variables into client-side JavaScript, so this stays
# server-only and is never shipped to the browser. It's read exclusively
# by src/lib/ai-server.ts, which is only reachable through the
# createServerFn-wrapped functions in src/lib/ai-service.ts.
#
# Do NOT rename this to VITE_OPENROUTER_API_KEY — doing so would expose
# your key to anyone who opens devtools on the live site.
OPENROUTER_API_KEY=

# Optional — used as the HTTP-Referer header on OpenRouter requests.
# Defaults to https://peasiprofile.app if unset.
SITE_URL=
