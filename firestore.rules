rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to verify user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the document belongs to the requesting user
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Resumes collection
    match /resumes/{resumeId} {
      // Allow reading only if the resume belongs to the user
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      
      // Allow creating only if the authenticated user is assigning themselves as owner
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      
      // Allow updating only if the resume belongs to the user and uid is not changed
      allow update: if isAuthenticated() 
                    && resource.data.uid == request.auth.uid 
                    && request.resource.data.uid == request.auth.uid;
      
      // Allow deletion only if the resume belongs to the user
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
